# Template only. Copy this file to `.env` and update values for your machine.
# Do not commit real `.env` files.
#
# DATABASE_URL must point to a running PostgreSQL database.
# Create the `talar_saas_pwa` database locally, then update user/password/host if needed.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/talar_saas_pwa?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
# Optional dedicated secret for encrypting Telegram/SMS integration credentials.
# If omitted, NEXTAUTH_SECRET/AUTH_SECRET is used by the notification secret helper.
NOTIFICATION_SECRET_KEY="replace-with-a-long-random-notification-secret"

# Scheduled notification cron endpoint
CRON_SECRET="change-me-long-random-secret"

# Platform Admin access
# The user must exist in the database and the email must match the logged-in account.
# Running `npm run prisma:seed` with these values creates/updates this admin user with a bcrypt password hash.
PLATFORM_ADMIN_EMAIL="bavafasobhan@gmail.com"
PLATFORM_ADMIN_PASSWORD="77365547"


# Optional Telegram Bot API proxy/base URL.
# Keep empty for the official API. Use only a trusted server-side proxy when local/server access to api.telegram.org is blocked.
# Example: TELEGRAM_API_BASE_URL="https://your-trusted-proxy.example.com"
TELEGRAM_API_BASE_URL=""
