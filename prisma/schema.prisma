  discountAmount       Decimal       @default(0) @db.Decimal(14, 2)
  paidAmountAtIssue    Decimal       @default(0) @db.Decimal(14, 2)
  payableAmount        Decimal       @default(0) @db.Decimal(14, 2)
  note                 String?
  contractSnapshot     Json?
  issuedByUserId       String
  issuedAt             DateTime      @default(now())
  approvedByUserId     String?
  approvedAt           DateTime?
  sentAt               DateTime?
  tenant               Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contract             Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  issuedBy             User          @relation("InvoiceIssuedBy", fields: [issuedByUserId], references: [id], onDelete: Restrict)
  approvedBy           User?         @relation("InvoiceApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  lines                InvoiceLine[]
  customerFeedbacks    CustomerInvoiceFeedback[]
  adjustmentRequests   InvoiceAdjustmentRequest[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@unique([tenantId, invoiceNo])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, issuedAt])
  @@index([issuedByUserId])
  @@index([approvedByUserId])
}

model InvoiceLine {
  id                 String                @id @default(cuid())
  tenantId           String
  invoiceId          String
  contractLineItemId String?
  sourceType         InvoiceLineSourceType
  name               String
  description        String?
  quantity           Int                   @default(1)
  unitLabel          String?
  unitPrice          Decimal               @default(0) @db.Decimal(14, 2)
  minUnitPrice       Decimal               @default(0) @db.Decimal(14, 2)
  totalPrice         Decimal               @default(0) @db.Decimal(14, 2)
  isLocked           Boolean               @default(true)
  sortOrder          Int                   @default(0)
  metadata           Json?
  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice            Invoice               @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  contractLineItem   ContractLineItem?     @relation(fields: [contractLineItemId], references: [id], onDelete: SetNull)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([tenantId])
  @@index([invoiceId])
  @@index([contractLineItemId])
  @@index([tenantId, sourceType])
}

model InvoiceAdjustmentRequest {
  id                 String                  @id @default(cuid())
  tenantId           String
  invoiceId          String
  contractId         String
  requestedByUserId  String
  approvedByUserId   String?
  rejectedByUserId   String?
  appliedLineId      String?
  status             InvoiceAdjustmentStatus @default(PENDING)
  title              String
  description        String?
  reason             String
  quantity           Int                     @default(1)
  unitLabel          String?
  unitPrice          Decimal                 @default(0) @db.Decimal(14, 2)
  minUnitPrice       Decimal                 @default(0) @db.Decimal(14, 2)
  totalPrice         Decimal                 @default(0) @db.Decimal(14, 2)
  beforeSubtotal     Decimal?                @db.Decimal(14, 2)
  beforePayable      Decimal?                @db.Decimal(14, 2)
  afterSubtotal      Decimal?                @db.Decimal(14, 2)
  afterPayable       Decimal?                @db.Decimal(14, 2)
  ownerDecisionNote  String?
  requestedAt        DateTime                @default(now())
  approvedAt         DateTime?
  rejectedAt         DateTime?
  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice            Invoice                 @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  contract           Contract                @relation(fields: [contractId], references: [id], onDelete: Cascade)
  requestedBy        User                    @relation("InvoiceAdjustmentRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  approvedBy         User?                   @relation("InvoiceAdjustmentApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  rejectedBy         User?                   @relation("InvoiceAdjustmentRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: SetNull)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([tenantId])
  @@index([invoiceId])
  @@index([contractId])
  @@index([requestedByUserId])
  @@index([approvedByUserId])
  @@index([rejectedByUserId])
  @@index([tenantId, status])
  @@index([appliedLineId])
}

model PostEventConfirmation {
  id                String                       @id @default(cuid())
  tenantId          String
  contractId        String                       @unique
  confirmedByUserId String
  status            PostEventConfirmationStatus
  source            PostEventConfirmationSource @default(DASHBOARD_GATE)
  note              String?
  invoiceRequired   Boolean                      @default(false)
  cancellationRequired Boolean                   @default(false)
  cancellationAmount Decimal?                    @db.Decimal(14, 2)
  cancellationAmountManual Boolean               @default(false)
  confirmedAt       DateTime                     @default(now())
  tenant            Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contract          Contract                     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  confirmedBy       User                         @relation(fields: [confirmedByUserId], references: [id], onDelete: Restrict)
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, confirmedAt])
  @@index([confirmedByUserId])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String?
  action      String
  entityType  String
  entityId    String?
  title       String
  message     String
  beforeData  Json?
  afterData   Json?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  href        String?
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}

