generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
  ACCOUNTANT
  PARTNER
  TENANT_OPERATOR
  RECEPTION
  VIEWER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum TenantMemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum TenantStatus {
  DEMO
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum SubscriptionPlan {
  DEMO
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum DemoAccessStatus {
  AVAILABLE
  USED
  EXPIRED
}

enum PaymentMethodType {
  CASH
  CARD
  BANK_TRANSFER
  CARD_TO_CARD
  CHECK
  ONLINE
  OTHER
}

enum FinancialCategoryType {
  INCOME
  EXPENSE
  ASSET
  LIABILITY
  DISCOUNT
  TAX
  OTHER
}

enum ServicePricingType {
  FIXED
  PER_GUEST
  PER_HOUR
  PER_ITEM
  CUSTOM
}

enum ContractStatus {
  DRAFT
  RESERVED
  CONFIRMED
  COMPLETED
  CANCELED
}

enum PostEventConfirmationStatus {
  HELD
  NOT_HELD
}

enum PostEventConfirmationSource {
  DASHBOARD_GATE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  DISPUTED
  ACCEPTED
  SETTLED
  CANCELED
}

enum InvoiceLineSourceType {
  CONTRACT_LINE
  EXTRA_GUEST
  EXTRA_SERVICE
  DAMAGE
  TIME_EXTENSION
  OWNER_ADJUSTMENT
}

enum InvoiceAdjustmentStatus {
  PENDING
  APPLIED
  REJECTED
}



enum OwnerOperationModel {
  OWNER_OPERATED
  FIXED_RENT
  MANAGEMENT_CONTRACT
  MANAGEMENT_CONTRACT_WITH_MINIMUM_GUARANTEE
}

enum OwnerSettlementCycle {
  MONTHLY
}

enum OwnerSettlementStatus {
  DRAFT
  APPROVED
  PAID
}

enum CalendarDayStatus {
  NOTE
  BLOCKED
  CLOSED
  HOLIDAY
  FOLLOW_UP
}

enum ContractLineItemType {
  PACKAGE
  SERVICE
  MENU
  DRINK
  DESSERT
}

model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String               @unique
  phone               String?              @unique
  nationalCode        String?              @unique
  address             String?
  postalCode          String?
  passwordHash        String?
  emailVerifiedAt     DateTime?
  phoneVerifiedAt     DateTime?
  lastLoginAt         DateTime?
  status              UserStatus           @default(ACTIVE)
  memberships         TenantMember[]
  invitedTenantMembers TenantMember[]      @relation("TenantMemberInvitedBy")
  ownedTenants        Tenant[]             @relation("TenantOwner")
  demoAccesses        DemoAccess[]
  passwordResetTokens PasswordResetToken[]
  postEventConfirmations PostEventConfirmation[]
  issuedInvoices      Invoice[]            @relation("InvoiceIssuedBy")
  approvedInvoices    Invoice[]            @relation("InvoiceApprovedBy")
  requestedInvoiceAdjustments InvoiceAdjustmentRequest[] @relation("InvoiceAdjustmentRequestedBy")
  approvedInvoiceAdjustments  InvoiceAdjustmentRequest[] @relation("InvoiceAdjustmentApprovedBy")
  rejectedInvoiceAdjustments  InvoiceAdjustmentRequest[] @relation("InvoiceAdjustmentRejectedBy")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Tenant {
  id                  String              @id @default(cuid())
  name                String
  slug                String              @unique
  status              TenantStatus        @default(DEMO)
  ownerId             String
  owner               User                @relation("TenantOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members             TenantMember[]
  subscription        Subscription?
  demoAccesses        DemoAccess[]
  halls               Hall[]
  salons              Salon[]
  menus               Menu[]
  services            Service[]
  ceremonyPackages    CeremonyPackage[]
  contractSettings    ContractSetting?
  hallProfile         TenantHallProfile?
  paymentMethods      PaymentMethod[]
  financialCategories FinancialCategory[]
  customers           Customer[]
  contracts           Contract[]
  contractEventTypes  ContractEventType[]
  contractLineItems   ContractLineItem[]
  payments            Payment[]
  paymentInstallments PaymentInstallment[]
  paymentCheques      PaymentCheque[]
  expenses            Expense[]
  expenseCheques      ExpenseCheque[]
  telegramIntegrationSetting TelegramIntegrationSetting?
  baleIntegrationSetting     BaleIntegrationSetting?
  rubikaIntegrationSetting   RubikaIntegrationSetting?
  smsIntegrationSetting      SmsIntegrationSetting?
  emailIntegrationSetting    EmailIntegrationSetting?
  notificationTemplates      NotificationTemplate[]
  notificationLogs           NotificationLog[]
  inAppNotifications         InAppNotification[]
  backupExportLogs           BackupExportLog[]
  calendarDayNotes    CalendarDayNote[]
  auditLogs           AuditLog[]
  supportTickets      SupportTicket[]
  supportTicketMessages SupportTicketMessage[]
  supportTicketAttachments SupportTicketAttachment[]
  contractAccessLinks       ContractAccessLink[]
  contractFeedbacks         ContractFeedback[]
  customerClubMembers       CustomerClubMember[]
  weddingProfiles           WeddingProfile[]
  weddingMusicRequests      WeddingMusicRequest[]
  guestOtpChallenges        GuestOtpChallenge[]
  reminderRecords           ReminderRecord[]
  postEventConfirmations    PostEventConfirmation[]
  invoices                  Invoice[]
  invoiceLines              InvoiceLine[]
  customerInvoiceFeedbacks  CustomerInvoiceFeedback[]
  ownerOperationSetting     OwnerOperationSetting?
  ownerMonthlySettlements   OwnerMonthlySettlement[]
  invoiceAdjustmentRequests InvoiceAdjustmentRequest[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([ownerId])
}

model TenantMember {
  id                  String             @id @default(cuid())
  tenantId            String
  userId              String
  role                UserRole           @default(STAFF)
  status              TenantMemberStatus @default(ACTIVE)
  title               String?
  permissionsOverride Json?
  invitedByUserId     String?
  lastAccessAt        DateTime?
  mustChangePassword  Boolean            @default(false)
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy           User?              @relation("TenantMemberInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, role])
  @@index([tenantId, status])
  @@index([invitedByUserId])
}

model Subscription {
  id                 String             @id @default(cuid())
  tenantId           String             @unique
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan   @default(DEMO)
  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  purchaseReference  String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model TenantHallProfile {
  id                  String    @id @default(cuid())
  tenantId            String    @unique
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandName           String?
  legalName           String?
  managerName         String?
  managerNationalCode String?
  registrationNumber  String?
  economicCode        String?
  licenseNumber       String?
  licenseIssuedAt     DateTime?
  licenseExpiresAt    DateTime?
  licenseImageUrl     String?
  licenseImageKey     String?
  hallLogoUrl         String?
  hallLogoKey         String?
  province            String?
  city                String?
  address             String?
  postalCode          String?
  phone               String?
  mobile              String?
  email               String?
  website             String?
  instagram           String?
  totalCapacity       Int?
  parkingCapacity     Int?
  hasParking          Boolean   @default(false)
  hasBrideRoom        Boolean   @default(false)
  hasCateringKitchen  Boolean   @default(false)
  hasOutdoorSpace     Boolean   @default(false)
  hasValet            Boolean   @default(false)
  description         String?
  internalNote        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([brandName])
  @@index([licenseNumber])
}

model DemoAccess {
  id        String           @id @default(cuid())
  userId    String           @unique
  tenantId  String?
  status    DemoAccessStatus @default(AVAILABLE)
  usedAt    DateTime?
  expiresAt DateTime?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([tenantId])
}

model Hall {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  code          String?
  province      String?
  city          String?
  address       String?
  phone         String?
  managerName   String?
  totalCapacity Int?
  description   String?
  isActive      Boolean  @default(true)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salons        Salon[]
  contracts     Contract[]
  expenses      Expense[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId])
}

model Salon {
  id                  String   @id @default(cuid())
  tenantId            String
  hallId              String
  name                String
  code                String?
  floor               String?
  locationNote        String?
  capacity            Int?
  minCapacity         Int?
  maxCapacity         Int?
  basePrice           Decimal? @db.Decimal(14, 2)
  hasStage            Boolean  @default(false)
  hasDanceFloor       Boolean  @default(false)
  hasSeparateEntrance Boolean  @default(false)
  hasVipRoom          Boolean  @default(false)
  hasSoundSystem      Boolean  @default(false)
  hasProjector        Boolean  @default(false)
  description         String?
  isActive            Boolean  @default(true)
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hall                Hall     @relation(fields: [hallId], references: [id], onDelete: Cascade)
  contracts           Contract[]
  expenses            Expense[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([hallId, name])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([hallId])
  @@index([tenantId, hallId])
}

model Menu {
  id            String   @id @default(cuid())
  tenantId      String
  title         String
  code          String?
  description   String?
  category      String?
  pricingType   ServicePricingType @default(PER_GUEST)
  unit          String   @default("نفر")
  pricePerGuest Decimal  @db.Decimal(12, 2)
  basePrice     Decimal? @db.Decimal(14, 2)
  minGuests     Int?
  maxGuests     Int?
  currency      String   @default("IRR")
  includedItems String?
  notes         String?
  items         Json?
  isRecommended Boolean  @default(false)
  isTaxable     Boolean  @default(true)
  allowPriceOverride Boolean @default(true)
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, title])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, isActive])
}

model Service {
  id          String             @id @default(cuid())
  tenantId    String
  title       String
  code        String?
  description String?
  category    String?
  pricingType ServicePricingType @default(FIXED)
  unit        String
  price       Decimal            @db.Decimal(12, 2)
  basePrice   Decimal?           @db.Decimal(14, 2)
  isRequired  Boolean            @default(false)
  allowPriceOverride Boolean     @default(true)
  sortOrder   Int                @default(0)
  notes       String?
  isActive    Boolean            @default(true)
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([tenantId, title])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, isActive])
}

model CeremonyPackage {
  id                 String   @id @default(cuid())
  tenantId           String
  title              String
  code               String?
  description        String?
  pricePerGuest      Decimal  @default(0) @db.Decimal(14, 2)
  serviceIds         String[] @default([])
  menuIds            String[] @default([])
  includedItemsNote  String?
  allowPriceOverride Boolean  @default(true)
  sortOrder          Int      @default(0)
  isActive           Boolean  @default(true)
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([tenantId, title])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, isActive])
}


model ContractSetting {
  id                     String   @id @default(cuid())
  tenantId               String   @unique
  contractPrefix         String   @default("TLR")
  nextNumber             Int      @default(1)
  fiscalYear             String?
  defaultDepositPercent  Decimal  @default(0) @db.Decimal(5, 2)
  defaultTaxPercent      Decimal  @default(0) @db.Decimal(5, 2)
  defaultDiscountPercent Decimal  @default(0) @db.Decimal(5, 2)
  defaultClauses         String?
  templateBody           String?
  cancellationPolicy     String?
  paymentTerms           String?
  footerNote             String?
  customerSignatureLabel String   @default("امضای مشتری")
  managerSignatureLabel  String   @default("امضای مدیر تالار")
  printTemplateName      String?
  showLogoOnPrint        Boolean  @default(true)
  showLicenseInfoOnPrint Boolean  @default(true)
  requireNationalCode    Boolean  @default(false)
  requirePhone           Boolean  @default(true)
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model PaymentMethod {
  id            String            @id @default(cuid())
  tenantId      String
  title         String
  code          String?
  type          PaymentMethodType
  description   String?
  bankName      String?
  accountHolder String?
  accountNumber String?
  cardNumber    String?
  iban          String?
  posTerminalId String?
  gatewayName   String?
  isDefault     Boolean           @default(false)
  sortOrder     Int               @default(0)
  isActive      Boolean           @default(true)
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments      Payment[]
  expenses      Expense[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([tenantId, title])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, isActive])
}

model FinancialCategory {
  id          String                @id @default(cuid())
  tenantId    String
  title       String
  code        String?
  type        FinancialCategoryType
  description String?
  color       String?
  icon        String?
  parentId    String?
  parent      FinancialCategory?    @relation("FinancialCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    FinancialCategory[]   @relation("FinancialCategoryTree")
  isSystem    Boolean               @default(false)
  isActive    Boolean               @default(true)
  sortOrder   Int                   @default(0)
  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expenses    Expense[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([tenantId, title, type])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, parentId])
  @@index([tenantId, isActive])
}

model Customer {
  id           String     @id @default(cuid())
  tenantId     String
  salutation   String?
  fullName     String
  phone        String
  nationalId   String?
  nationalCode String?
  address      String?
  notes        String?
  isActive     Boolean    @default(true)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contracts    Contract[]
  payments     Payment[]
  expenses     Expense[]
  clubMembers  CustomerClubMember[]
  invoiceFeedbacks CustomerInvoiceFeedback[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([tenantId, phone])
  @@index([tenantId, nationalCode])
  @@index([tenantId, isActive])
}

model ContractEventType {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  contracts Contract[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, isActive])
}

model Contract {
  id              String             @id @default(cuid())
  tenantId        String
  customerId      String
  contractNo      String
  title           String
  notes           String?
  status          ContractStatus     @default(DRAFT)
  eventTypeId     String?
  eventTypeName   String?
  eventDate       DateTime
  eventStartTime  String?
  eventEndTime    String?
  guestCount      Int
  hallId          String?
  salonId         String?
  packageId       String?
  packageName     String?
  packageTotal    Decimal            @default(0) @db.Decimal(14, 2)
  packageTotalManual Boolean         @default(false)
  packagePricePerGuest Decimal       @default(0) @db.Decimal(14, 2)
  packageSnapshot Json?
  servicesTotal       Decimal            @default(0) @db.Decimal(14, 2)
  servicesTotalManual Boolean            @default(false)
  menuTotal           Decimal            @default(0) @db.Decimal(14, 2)
  menuTotalManual     Boolean            @default(false)
  discountAmount      Decimal            @default(0) @db.Decimal(14, 2)
  depositAmount       Decimal            @default(0) @db.Decimal(14, 2)
  finalTotal          Decimal            @default(0) @db.Decimal(14, 2)
  finalTotalManual    Boolean            @default(false)
  remainingAmount     Decimal            @default(0) @db.Decimal(14, 2)
  remainingAmountManual Boolean          @default(false)
  totalAmount     Decimal            @db.Decimal(14, 2)
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  eventType       ContractEventType? @relation(fields: [eventTypeId], references: [id], onDelete: SetNull)
  hall            Hall?              @relation(fields: [hallId], references: [id], onDelete: SetNull)
  salon           Salon?             @relation(fields: [salonId], references: [id], onDelete: SetNull)
  lineItems       ContractLineItem[]
  payments        Payment[]
  paymentInstallments PaymentInstallment[]
  paymentCheques PaymentCheque[]
  expenses        Expense[]
  accessLinks     ContractAccessLink[]
  feedbacks       ContractFeedback[]
  customerInvoiceFeedbacks CustomerInvoiceFeedback[]
  clubMembers     CustomerClubMember[]
  weddingProfile  WeddingProfile?
  musicRequests   WeddingMusicRequest[]
  reminderRecords ReminderRecord[]
  postEventConfirmation PostEventConfirmation?
  invoice         Invoice?
  invoiceAdjustmentRequests InvoiceAdjustmentRequest[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([tenantId, contractNo])
  @@index([tenantId, eventDate])
  @@index([tenantId, hallId])
  @@index([tenantId, salonId])
  @@index([customerId])
}

model ContractLineItem {
  id         String               @id @default(cuid())
  tenantId   String
  contractId String
  type       ContractLineItemType
  pricingType ServicePricingType?
  category   String?
  name       String
  sourceId   String?
  quantity   Int                  @default(1)
  unitLabel  String?
  unitPrice  Decimal              @default(0) @db.Decimal(14, 2)
  totalPrice Decimal              @default(0) @db.Decimal(14, 2)
  note       String?
  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contract     Contract             @relation(fields: [contractId], references: [id], onDelete: Cascade)
  invoiceLines InvoiceLine[]
  createdAt    DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([tenantId])
  @@index([contractId])
  @@index([tenantId, type])
}

model Payment {
  id              String         @id @default(cuid())
  tenantId        String
  contractId      String?
  customerId      String?
  paymentMethodId String?
  type            String         @default("DEPOSIT")
  status          String         @default("RECORDED")
  amount          Decimal        @db.Decimal(14, 2)
  paidAt          DateTime
  reference       String?
  referenceNumber String?
  trackingCode    String?
  chequeNumber    String?
  chequeDueDate   DateTime?
  receiptImageUrl String?
  receiptImageKey String?
  note            String?
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contract        Contract?      @relation(fields: [contractId], references: [id], onDelete: SetNull)
  customer        Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  installments    PaymentInstallment[]
  cheques         PaymentCheque[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([tenantId])
  @@index([tenantId, paidAt])
  @@index([contractId])
  @@index([customerId])
  @@index([paymentMethodId])
  @@index([status])
  @@index([type])
}

model PaymentInstallment {
  id                String   @id @default(cuid())
  tenantId          String
  paymentId         String
  contractId        String?
  installmentNumber Int
  amount            Decimal  @db.Decimal(14, 2)
  dueDate           DateTime
  paidAt            DateTime?
  status            String   @default("PENDING")
  notes             String?
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment           Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  contract          Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([paymentId, installmentNumber])
  @@index([tenantId])
  @@index([paymentId])
  @@index([contractId])
  @@index([status])
  @@index([dueDate])
}

model PaymentCheque {
  id           String   @id @default(cuid())
  tenantId     String
  paymentId    String
  contractId   String?
  chequeNumber String
  bankName     String?
  branchName   String?
  ownerName    String?
  amount       Decimal  @db.Decimal(14, 2)
  dueDate      DateTime
  status       String   @default("PENDING")
  notes        String?
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment      Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  contract     Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@index([paymentId])
  @@index([contractId])
  @@index([status])
  @@index([dueDate])
}

model ExpenseCheque {
  id            String   @id @default(cuid())
  tenantId      String
  expenseId     String
  chequeNumber  String
  bankName      String?
  branchName    String?
  recipientName String?
  amount        Decimal  @db.Decimal(14, 2)
  dueDate       DateTime
  status        String   @default("PENDING")
  notes         String?
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expense       Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([expenseId])
  @@index([status])
  @@index([dueDate])
}

model Expense {
  id                  String             @id @default(cuid())
  tenantId            String
  contractId          String?
  customerId          String?
  hallId              String?
  salonId             String?
  financialCategoryId String?
  paymentMethodId     String?
  title               String             @default("هزینه عملیاتی")
  amount              Decimal            @db.Decimal(14, 2)
  occurredAt          DateTime
  status              String             @default("RECORDED")
  description         String             @default("")
  vendorName          String?
